<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimum possible device-admin policy: force-lock only, so the panel can turn
  the display off. No password rules, no wipe, no camera policy.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
