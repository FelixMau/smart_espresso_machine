<?xml version="1.0" encoding="utf-8"?>
<!--
  The ESP32 speaks plain HTTP on the local network, so cleartext has to be
  allowed. It is limited to private address ranges plus .local names, so the app
  still cannot talk cleartext to anything on the internet.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
    </domain-config>
</network-security-config>
